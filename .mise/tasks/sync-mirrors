#!/usr/bin/env bash
#MISE description="Generate claude mirrors of opencode resources across the orchestrator and skills trees. Run after editing opencode resources. Use --check for CI to fail on drift. On Claude, every opencode command dual-emits as both a legacy .claude/commands/osx/<name>.md and a modern .claude/skills/<name>/SKILL.md (mirrors upstream OpenSpec's dual-emit strategy, introduced in v1.7.0, current as of v1.11.0)."
#USAGE flag "--check" help="Verify claude mirrors are in sync; exit non-zero on drift"

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Phase 4 split: two parallel trees to mirror.
readonly ORCH_OPENCODE="$PROJECT_ROOT/orchestrator/resources/opencode"
readonly ORCH_CLAUDE="$PROJECT_ROOT/orchestrator/resources/claude"
readonly SK_OPENCODE="$PROJECT_ROOT/skills/resources/opencode"
readonly SK_CLAUDE="$PROJECT_ROOT/skills/resources/claude"

CHECK_ONLY="false"
[[ "${1:-}" == "--check" ]] && CHECK_ONLY="true"

# Header prepended to every generated file.
readonly GEN_HEADER="# AUTO-GENERATED from opencode via \`mise run sync:mirrors\` — do not edit by hand."

# Token substitution is the deploy step's responsibility (Python side, see
# ``source/cli.py:_substitute_tokens``). Mirrors carry ``{{TOKEN}}`` placeholders
# verbatim; the deploy substitutes per-platform values at install/update time.
# This script is a pure mirror — it does NOT rewrite tokens.

log_info() { printf '  -> %s\n' "$*"; }
log_warn() { printf '  !! %s\n' "$*" >&2; }

# Compute the claude-side path for a given opencode-side relative path.
# Three layout differences:
#   - commands/osx-<X>.md (opencode) → commands/osx/<X>.md (claude, legacy form)
#   - commands/osx-<X>.md (opencode) also emits skills/osx-<X>/SKILL.md
#     (claude, modern form — mirrors upstream OpenSpec's dual-emit strategy,
#      introduced in v1.7.0, current as of v1.11.0).
#   - everything else: same directory layout, just swap "opencode/" for "claude/"
#
# Returns the *primary* target (the legacy command file). The skill mirror
# runs separately via mirror_command_skill() so that we always emit both
# forms even when only one side has changed.
claude_path_for() {
    local rel="$1"
    local oc_root="$2"
    local cl_root="$3"
    local rel_no_oc="${rel#opencode/}"
    case "$rel_no_oc" in
        commands/osx-*.md)
            local stem="${rel_no_oc#commands/osx-}"
            printf '%s\n' "$cl_root/commands/osx/${stem}"
            ;;
        *)
            printf '%s\n' "$cl_root/${rel_no_oc}"
            ;;
    esac
}

# Compute the claude-side skill path for an opencode command file.
# commands/osx-<X>.md → skills/osx-<X>/SKILL.md
claude_skill_path_for_command() {
    local rel="$1"
    local cl_root="$2"
    local rel_no_oc="${rel#opencode/}"
    case "$rel_no_oc" in
        commands/osx-*.md)
            local stem="${rel_no_oc#commands/osx-}"
            local base="${stem%.md}"
            printf '%s\n' "$cl_root/skills/osx-${base}/SKILL.md"
            ;;
        *)
            return 1
            ;;
    esac
}

# Header lines for generated files. The marker is appended AFTER the
# frontmatter so tools that read the file expecting it to start with `---`
# (e.g. tests, validators) still see the frontmatter at the top.
append_header() {
    local rel="$1"
    cat <<HDR

<!--
$GEN_HEADER
Source: opencode/$rel
Regenerate: \`mise run sync:mirrors\`
-->

HDR
}

# Mirror one file from opencode to claude.
# In --check mode, exits 1 if the destination would change.
# In write mode, writes the destination if it would change.
mirror_file() {
    local rel="$1"
    local oc_root="$2"
    local cl_root="$3"
    local src="$oc_root/$rel"
    local dst
    dst=$(claude_path_for "$rel" "$oc_root" "$cl_root")

    if [[ ! -f "$src" ]]; then
        log_warn "source missing: $src"
        return 0
    fi

    # AGENTS.md files are platform-specific and hand-maintained. Skip.
    case "$rel" in
        */AGENTS.md) return 0 ;;
    esac

    local body_with_header
    body_with_header=$( {
        cat "$src"
        append_header "$rel"
    } )

    local current=""
    if [[ -f "$dst" ]]; then
        current=$(cat "$dst")
    fi

    if [[ "$current" == "$body_with_header" ]]; then
        return 0
    fi

    if [[ "$CHECK_ONLY" == "true" ]]; then
        log_warn "DRIFT: ${dst#"$PROJECT_ROOT"/}"
        return 1
    fi

    mkdir -p "$(dirname "$dst")"
    printf '%s\n' "$body_with_header" > "$dst"
    log_info "wrote ${dst#"$PROJECT_ROOT"/}"
}

# Emit the Claude skill mirror for an opencode command file.
# OpenCode commands carry `agent:` frontmatter (opencode-specific dispatch) but
# no `name:` field; the Claude skill needs `name:` and no `agent:`. We also
# copy skill-shared references referenced from the command body so the skill
# is self-sufficient at deploy time.
mirror_command_skill() {
    local rel="$1"
    local oc_root="$2"
    local cl_root="$3"
    local src="$oc_root/$rel"
    local dst
    if ! dst=$(claude_skill_path_for_command "$rel" "$cl_root"); then
        return 0
    fi

    if [[ ! -f "$src" ]]; then
        return 0
    fi

    # Hand-maintained AGENTS.md files never reach this script.
    case "$rel" in
        */AGENTS.md) return 0 ;;
    esac

    local base_name
    base_name=$(basename "${rel%.md}")
    # base_name is "osx-<X>" — slash command name will be /<base_name>.
    local skill_name="$base_name"

    # Build the SKILL.md body: re-emit the frontmatter with `name:` set, drop
    # the opencode-only `agent:` field, then append the original body.
    local body
    body=$(awk '
        BEGIN { in_fm=0; seen_fm=0 }
        /^---[[:space:]]*$/ {
            if (in_fm == 0) { in_fm = 1; print; next }
            else {
                if (seen_fm == 0) {
                    print "name: '"$skill_name"'"
                    seen_fm = 1
                    print "---"
                    in_fm = 0
                    next
                }
            }
        }
        in_fm == 1 {
            # Keep description/license/compatibility/allowed-tools;
            # drop agent: (opencode-only dispatch).
            if ($0 ~ /^agent:[[:space:]]/) next
            print
            next
        }
        in_fm == 0 { print }
    ' "$src")

    local generated
    generated=$( {
        printf '%s\n' "$body"
        append_header "$rel"
    } )

    local current=""
    if [[ -f "$dst" ]]; then
        current=$(cat "$dst")
    fi

    if [[ "$current" == "$generated" ]]; then
        return 0
    fi

    if [[ "$CHECK_ONLY" == "true" ]]; then
        log_warn "DRIFT: ${dst#"$PROJECT_ROOT"/}"
        return 1
    fi

    mkdir -p "$(dirname "$dst")"
    printf '%s\n' "$generated" > "$dst"
    log_info "wrote ${dst#"$PROJECT_ROOT"/}"
}

# Mirror the manifest file. The manifest has no platform-specific content;
# the opencode manifest is the canonical source.
mirror_manifest() {
    local src="$1"
    local dst="$2"
    local label="$3"

    if [[ ! -f "$src" ]]; then
        log_warn "opencode manifest missing: $src"
        return 0
    fi

    local generated
    generated=$( {
        cat "$src"
        echo
        echo "# AUTO-GENERATED from ${src#"$PROJECT_ROOT"/} via \`mise run sync:mirrors\`."
        echo "# Regenerate: \`mise run sync:mirrors\`"
    } )

    local current=""
    if [[ -f "$dst" ]]; then
        current=$(cat "$dst")
    fi

    if [[ "$current" == "$generated" ]]; then
        return 0
    fi

    if [[ "$CHECK_ONLY" == "true" ]]; then
        log_warn "DRIFT: ${dst#"$PROJECT_ROOT"/}"
        return 1
    fi

    mkdir -p "$(dirname "$dst")"
    printf '%s\n' "$generated" > "$dst"
    log_info "wrote ${dst#"$PROJECT_ROOT"/} ($label)"
}

# Mirror a single side (orchestrator OR skills).
mirror_side() {
    local oc_root="$1"
    local cl_root="$2"
    local label="$3"

    if [[ ! -d "$oc_root" ]]; then
        log_warn "opencode tree not found: $oc_root"
        return 0
    fi

    # Mirror all SKILL.md and references/*.md under skills/.
    while IFS= read -r -d '' src; do
        local rel="${src#"$oc_root"/}"
        mirror_file "$rel" "$oc_root" "$cl_root" || drift=1
    done < <(find "$oc_root/skills" \
                \( -path "*/SKILL.md" -o -path "*/references/*.md" -o -path "*/scripts/*" \) \
                -type f \
                -print0 2>/dev/null || true)

    # Mirror all command files. Each opencode command also dual-emits on
    # the Claude side as a skill (mirroring upstream OpenSpec — introduced
    # in v1.7.0, current as of v1.11.0).
    while IFS= read -r -d '' src; do
        local rel="${src#"$oc_root"/}"
        mirror_file "$rel" "$oc_root" "$cl_root" || drift=1
        mirror_command_skill "$rel" "$oc_root" "$cl_root" || drift=1
    done < <(find "$oc_root/commands" \
                -type f -name "*.md" \
                -print0 2>/dev/null || true)

    # Mirror the manifest. Claude doesn't have agents/ so we skip those.
    mirror_manifest "$oc_root/manifest.toml" "$cl_root/manifest.toml" "$label manifest" || drift=1
}

main() {
    local drift=0

    mirror_side "$ORCH_OPENCODE" "$ORCH_CLAUDE" "orchestrator" || drift=1
    mirror_side "$SK_OPENCODE" "$SK_CLAUDE" "skills" || drift=1

    if [[ "$CHECK_ONLY" == "true" ]]; then
        if (( drift )); then
            echo
            echo "Mirror drift detected. Run: mise run sync:mirrors" >&2
            exit 1
        fi
        echo "Mirror sync OK."
        exit 0
    fi

    echo "Mirror sync complete."
}

main "$@"
